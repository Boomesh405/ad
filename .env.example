# ============================================================
# EstateHub environment variables — copy to .env and fill in.
# `docker compose up` reads these automatically.
# ============================================================

# --- PostgreSQL ---
# Password for the estatehub_user database role (also used by the app).
DB_PASSWORD=estatehub_dev_password

# --- JWT ---
# HS512 signing secret. MUST be at least 64 bytes and unique per environment.
# Generate with:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_to_a_random_secret_at_least_64_bytes_long_for_HS512!!

# --- Webhooks (match values configured in your Razorpay / Digio dashboards) ---
RAZORPAY_WEBHOOK_SECRET=
DIGIO_WEBHOOK_SECRET=

# --- CORS ---
# Comma-separated origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8080

# --- Optional third-party keys (features are wired but need real accounts) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DIGIO_API_KEY=
DIGIO_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
GOOGLE_MAPS_API_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
